{
	"luci-theme-veil": {
		"description": "Grant UCI and file access for luci-theme-veil config view",
		"read": {
			"file": {
				"/www/luci-static/veil/background/*": [ "list" ]
			},
			"ubus": {
				"luci.veil": [ "avail", "remove", "rename", "set_mode", "get_version", "check_download", "get_install_log" ]
			},
			"uci": [ "veil" ]
		},
		"write": {
			"file": {
				"/tmp/veil_background.tmp": [ "write" ],
				"/tmp/veil-update.ipk": [ "write" ],
				"/tmp/veil-update.apk": [ "write" ]
			},
			"ubus": {
				"luci.veil": [ "set_mode", "do_install", "start_download" ]
			},
			"uci": [ "veil" ]
		}
	}
}
